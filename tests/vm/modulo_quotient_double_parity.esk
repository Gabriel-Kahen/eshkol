(define saved-modulo modulo)
(define saved-quotient quotient)
(define large-integer (expt 2 100))

;; Before this parity correction, direct modulo answered real 2.6 while the
;; stored closure answered integer 1; both quotient calls answered integer 2.
(if (and (= (modulo 5.5 2.9) 2.6)
         (= (saved-modulo 5.5 2.9) 2.6)
         (eq? (type-of (modulo 5.5 2.9)) 'real)
         (eq? (type-of (saved-modulo 5.5 2.9)) 'real)
         (= (quotient 5.5 2.9) 1.0)
         (= (saved-quotient 5.5 2.9) 1.0)
         (eq? (type-of (quotient 5.5 2.9)) 'real)
         (eq? (type-of (saved-quotient 5.5 2.9)) 'real)
         (string=? (number->string (modulo -0.0 3.0)) "-0.0")
         (string=? (number->string (saved-modulo -0.0 3.0)) "-0.0")
         (string=? (number->string (quotient -0.0 3.0)) "-0.0")
         (string=? (number->string (saved-quotient -0.0 3.0)) "-0.0")
         (= (modulo -5 3) 1)
         (= (saved-modulo -5 3) 1)
         (= (quotient -5 3) -1)
         (= (saved-quotient -5 3) -1)
         (eq? (type-of (saved-modulo -5 3)) 'integer)
         (eq? (type-of (saved-quotient -5 3)) 'integer)
         (= (modulo large-integer 3) 1)
         (= (saved-modulo large-integer 3) 1)
         (equal? (quotient large-integer 3)
                 (saved-quotient large-integer 3)))
    (display "PASS: VM modulo/quotient DOUBLE and integer routes")
    (display "FAIL: VM modulo/quotient DOUBLE and integer routes"))
