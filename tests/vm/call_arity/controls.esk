(define (one x) x)
(define (all . xs) xs)
(define (head x . xs) x)
(define bare (lambda xs xs))

(if (and (= (one 7) 7)
         (= (min 3.5 2.5) 2.5)
         (= (max 3.5 2.5 4.5) 4.5)
         (= (head 8) 8)
         (= (head 9 10 11) 9)
         (= (length (all)) 0)
         (= (length (all 1 2 3)) 3)
         (= (length (bare)) 0)
         (= (length (bare 1 2)) 2)
         (equal? (map (lambda (x) (+ x 1)) (list 1 2)) (list 2 3)))
    (display "PASS: VM fixed and variadic closure arity controls")
    (display "FAIL: VM fixed and variadic closure arity controls"))
