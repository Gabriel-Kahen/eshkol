(define unary-min min)
(define unary-max max)

(if (and (= (min 2.5) 2.5)
         (eq? (type-of (min 2.5)) 'real)
         (= (max -0.0) 0.0)
         (eq? (type-of (max -0.0)) 'real)
         (string=? (number->string (min -0.0)) "-0.0")
         (string=? (number->string (max -0.0)) "-0.0")
         (= (min 7) 7)
         (eq? (type-of (min 7)) 'integer)
         (= (max 8) 8)
         (eq? (type-of (max 8)) 'integer)
         (= (unary-min 4.5) 4.5)
         (eq? (type-of (unary-min 4.5)) 'real)
         (= (unary-max -0.0) 0.0)
         (eq? (type-of (unary-max -0.0)) 'real)
         (string=? (number->string (unary-min -0.0)) "-0.0")
         (string=? (number->string (unary-max -0.0)) "-0.0")
         (equal? (map min (list 3 4)) (list 3 4))
         (= (min 3.5 2.5) 2.5)
         (= (max 3.5 2.5 4.5) 4.5))
    (display "PASS: VM unary min/max preserve numeric type and variadic calls")
    (display "FAIL: VM unary min/max numeric contract"))
