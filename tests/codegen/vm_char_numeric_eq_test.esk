;; Character equality is used by scanners; numeric opcodes still reject chars.
(define passed 0)
(define failed 0)
(define (check name actual)
  (if actual
      (begin (set! passed (+ passed 1)) (display "PASS: ") (display name) (newline))
      (begin (set! failed (+ failed 1)) (display "FAIL: ") (display name) (newline))))

(check "equal characters" (= #\space #\space))
(check "different characters" (not (= #\space #\tab)))
(check "string-ref character" (= (string-ref "a b" 1) #\space))
(check "numeric equality" (= 2 2))
(check "mixed character and number rejected"
       (guard (e (#t #t)) (= #\a 97) #f))
(check "character arithmetic rejected"
       (guard (e (#t #t)) (+ #\a 1) #f))

(display "SUMMARY: ") (display passed) (display " passed, ")
(display failed) (display " failed") (newline)
