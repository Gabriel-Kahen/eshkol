(begin
(require core.json)
(begin
(extern f32 f32-host-value i64 :real f32_reachability_value)
(extern i64 f32-host-persistence-prepare i64 i64 :real f32_reachability_persistence_prepare)
(extern i64 f32-host-persistence-check i64 i64 :real f32_reachability_persistence_check)
(extern i64 f32-host-json-finish i64 :real f32_reachability_json_finish)

(define f32-finite (f32-host-value 3))
(define f32-infinity (f32-host-value 4))
(define f32-qnan (f32-host-value 5))
(define f32-json-pid (process-pid))
(define f32-json-path
  (format "/tmp/eshkol-f32-persistence-~d.kb" f32-json-pid))

(define (json-rejected? thunk)
  (guard (condition (#t #t))
    (begin (thunk) #f)))

(define f32-json-port (open-output-string))
(write-string "sentinel" f32-json-port)
(define f32-json-port-rejected
  (json-rejected?
    (lambda () (json-write (list 7 f32-finite) f32-json-port))))
(define f32-json-port-unchanged
  (string=? (get-output-string f32-json-port) "sentinel"))
(close-port f32-json-port)

(define f32-json-file-rejected
  (and
    (= (f32-host-persistence-prepare 0 f32-json-pid) 1)
    (json-rejected?
      (lambda () (json-write-file f32-json-path (list f32-qnan))))
    (= (f32-host-persistence-check 0 f32-json-pid) 1)))

(define f32-json-path-rejected
  (and
    (= (f32-host-persistence-prepare 0 f32-json-pid) 1)
    (json-rejected?
      (lambda () (json-write (list f32-infinity) f32-json-path)))
    (= (f32-host-persistence-check 0 f32-json-pid) 1)))

(define f32-json-alist-file-rejected
  (and
    (= (f32-host-persistence-prepare 0 f32-json-pid) 1)
    (json-rejected?
      (lambda ()
        (alist-write-json f32-json-path
                          (list (cons "metric" f32-finite)))))
    (= (f32-host-persistence-check 0 f32-json-pid) 1)))

(define f32-json-ok
  (and
    ;; Existing JSON values remain admitted.
    (string=? (json-stringify (list 7 1.5)) "[7,1.5]")
    ;; JSON parsing retains the established integer/f64 semantic types.
    (eq? (type-of (json-parse "7")) 'integer)
    (eq? (type-of (json-parse "1.5")) 'real)
    ;; Direct, nested, object, finite, infinity, and NaN values all reject.
    (json-rejected? (lambda () (json-stringify f32-finite)))
    (json-rejected? (lambda () (json-stringify f32-infinity)))
    (json-rejected? (lambda () (json-stringify f32-qnan)))
    (json-rejected? (lambda () (json-stringify (list 7 f32-finite))))
    (json-rejected?
      (lambda () (alist->json (list (cons "metric" f32-qnan)))))
    f32-json-port-rejected
    f32-json-port-unchanged
    f32-json-file-rejected
    f32-json-path-rejected
    f32-json-alist-file-rejected))

(f32-host-json-finish (if f32-json-ok 1 0))))
