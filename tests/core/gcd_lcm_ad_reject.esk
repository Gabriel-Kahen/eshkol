(define saved-gcd gcd)
(define saved-lcm lcm)
(define (raises? thunk)
  (guard (condition (else #t)) (begin (thunk) #f)))
(define ok
  (and (raises? (lambda () (derivative (lambda (x) (gcd x 2)) 6.0)))
       (raises? (lambda () (derivative (lambda (x) (saved-gcd x 2)) 6.0)))
       (raises? (lambda () (derivative (lambda (x) (lcm x 2)) 6.0)))
       (raises? (lambda () (derivative (lambda (x) (saved-lcm x 2)) 6.0)))
       (raises? (lambda () (gradient (lambda (x) (gcd x 2)) 6.0)))
       (raises? (lambda () (gradient (lambda (x) (saved-gcd x 2)) 6.0)))
       (raises? (lambda () (gradient (lambda (x) (lcm x 2)) 6.0)))
       (raises? (lambda () (gradient (lambda (x) (saved-lcm x 2)) 6.0)))
       (= (derivative (lambda (x) 4) 6.0) 0.0)))
(if ok (begin (display "PASS: gcd/lcm AD rejection") (newline))
    (begin (display "FAIL: gcd/lcm AD rejection") (newline)))
