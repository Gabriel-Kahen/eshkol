;; Canonical f32 follows each operation's established DOUBLE result path.
(begin
  (extern f32 f32-unary-value i64 :real f32_unary_value)
  (extern i64 f32-unary-check i64 i64 f64 :real f32_unary_check)
  (extern i64 f32-unary-finish i64 :real f32_unary_finish)

  ;; Public AOT symbols allow malformed/folded carrier injection at the
  ;; compiled boundary. JIT reaches them through ordinary language calls.
  (define (f32_unary_plus_probe x) (+ x))
  (define (f32_unary_multiply_probe x) (* x))
  (define (f32_unary_divide_probe x) (/ x))
  (define (f32_unary_min_probe x) (min x))
  (define (f32_unary_max_probe x) (max x))
  (define (f32_unary_denominator_probe x) (denominator x))
  (define saved-gcd gcd)
  (define saved-lcm lcm)
  (define saved-modulo modulo)
  (define saved-remainder remainder)
  (define saved-quotient quotient)
  (define (f32_modulo_probe x) (modulo x 1.0))
  (define (f32_remainder_probe x) (remainder x 1.0))
  (define (f32_quotient_probe x) (quotient x 1.0))
  (define (f32_modulo_stored_probe x) (saved-modulo x 1.0))
  (define (f32_remainder_stored_probe x) (saved-remainder x 1.0))
  (define (f32_quotient_stored_probe x) (saved-quotient x 1.0))
  (define (f32_integer_gcd_probe x) (gcd x 4))
  (define (f32_integer_lcm_probe x) (lcm x 4))
  (define (f32_integer_gcd_stored_probe x) (saved-gcd x 4))
  (define (f32_integer_lcm_stored_probe x) (saved-lcm x 4))
  (define (integer-helper-rejects? thunk)
    (guard (condition (#t #t)) (begin (thunk) #f)))
  (define (nth xs n) (if (= n 0) (car xs) (nth (cdr xs) (- n 1))))

  (define pzero (f32-unary-value 0))
  (define nzero (f32-unary-value 1))
  (define subnormal (f32-unary-value 2))
  (define normal (f32-unary-value 3))
  (define pinf (f32-unary-value 4))
  (define ninf (f32-unary-value 5))
  (define qnan (f32-unary-value 6))

  ;; `map` resolves these names as genuine arity-one first-class builtins.
  ;; min/max value-position closures remain deliberately binary.
  (define plus-values (map + (list pzero nzero subnormal normal pinf ninf qnan)))
  (define multiply-values (map * (list pzero nzero subnormal normal pinf ninf qnan)))
  (define divide-values (map / (list pzero nzero subnormal normal pinf ninf qnan)))
  (define denominator-values
    (map denominator (list pzero nzero subnormal normal pinf ninf qnan)))

  (f32-unary-finish
    (if
      (and
        (= (f32-unary-check 0 0 (+ pzero)) 1)
        (= (f32-unary-check 0 1 (+ nzero)) 1)
        (= (f32-unary-check 0 2 (+ subnormal)) 1)
        (= (f32-unary-check 0 3 (+ normal)) 1)
        (= (f32-unary-check 0 4 (+ pinf)) 1)
        (= (f32-unary-check 0 5 (+ ninf)) 1)
        (= (f32-unary-check 0 6 (+ qnan)) 1)
        (= (f32-unary-check 1 0 (* pzero)) 1)
        (= (f32-unary-check 1 1 (* nzero)) 1)
        (= (f32-unary-check 1 2 (* subnormal)) 1)
        (= (f32-unary-check 1 3 (* normal)) 1)
        (= (f32-unary-check 1 4 (* pinf)) 1)
        (= (f32-unary-check 1 5 (* ninf)) 1)
        (= (f32-unary-check 1 6 (* qnan)) 1)
        (= (f32-unary-check 2 0 (/ pzero)) 1)
        (= (f32-unary-check 2 1 (/ nzero)) 1)
        (= (f32-unary-check 2 2 (/ subnormal)) 1)
        (= (f32-unary-check 2 3 (/ normal)) 1)
        (= (f32-unary-check 2 4 (/ pinf)) 1)
        (= (f32-unary-check 2 5 (/ ninf)) 1)
        (= (f32-unary-check 2 6 (/ qnan)) 1)
        (= (f32-unary-check 3 0 (min pzero)) 1)
        (= (f32-unary-check 3 1 (min nzero)) 1)
        (= (f32-unary-check 3 2 (min subnormal)) 1)
        (= (f32-unary-check 3 3 (min normal)) 1)
        (= (f32-unary-check 3 4 (min pinf)) 1)
        (= (f32-unary-check 3 5 (min ninf)) 1)
        (= (f32-unary-check 3 6 (min qnan)) 1)
        (= (f32-unary-check 4 0 (max pzero)) 1)
        (= (f32-unary-check 4 1 (max nzero)) 1)
        (= (f32-unary-check 4 2 (max subnormal)) 1)
        (= (f32-unary-check 4 3 (max normal)) 1)
        (= (f32-unary-check 4 4 (max pinf)) 1)
        (= (f32-unary-check 4 5 (max ninf)) 1)
        (= (f32-unary-check 4 6 (max qnan)) 1)
        (= (f32-unary-check 0 0 (nth plus-values 0)) 1)
        (= (f32-unary-check 0 1 (nth plus-values 1)) 1)
        (= (f32-unary-check 0 2 (nth plus-values 2)) 1)
        (= (f32-unary-check 0 3 (nth plus-values 3)) 1)
        (= (f32-unary-check 0 4 (nth plus-values 4)) 1)
        (= (f32-unary-check 0 5 (nth plus-values 5)) 1)
        (= (f32-unary-check 0 6 (nth plus-values 6)) 1)
        (= (f32-unary-check 1 0 (nth multiply-values 0)) 1)
        (= (f32-unary-check 1 1 (nth multiply-values 1)) 1)
        (= (f32-unary-check 1 2 (nth multiply-values 2)) 1)
        (= (f32-unary-check 1 3 (nth multiply-values 3)) 1)
        (= (f32-unary-check 1 4 (nth multiply-values 4)) 1)
        (= (f32-unary-check 1 5 (nth multiply-values 5)) 1)
        (= (f32-unary-check 1 6 (nth multiply-values 6)) 1)
        (= (f32-unary-check 2 0 (nth divide-values 0)) 1)
        (= (f32-unary-check 2 1 (nth divide-values 1)) 1)
        (= (f32-unary-check 2 2 (nth divide-values 2)) 1)
        (= (f32-unary-check 2 3 (nth divide-values 3)) 1)
        (= (f32-unary-check 2 4 (nth divide-values 4)) 1)
        (= (f32-unary-check 2 5 (nth divide-values 5)) 1)
        (= (f32-unary-check 2 6 (nth divide-values 6)) 1)
        (not (float32? (+ normal)))
        (not (float32? (* normal)))
        (not (float32? (/ normal)))
        (not (float32? (min normal)))
        (not (float32? (max normal)))
        (= (denominator pzero) 1)
        (= (denominator nzero) 1)
        (= (denominator subnormal) 1)
        (= (denominator normal) 1)
        (= (denominator pinf) 1)
        (= (denominator ninf) 1)
        (= (denominator qnan) 1)
        (= (nth denominator-values 0) 1)
        (= (nth denominator-values 1) 1)
        (= (nth denominator-values 2) 1)
        (= (nth denominator-values 3) 1)
        (= (nth denominator-values 4) 1)
        (= (nth denominator-values 5) 1)
        (= (nth denominator-values 6) 1)
        (= (denominator 2.5) 1)
        (= (denominator 3) 1)
        (= (denominator (/ 1 3)) 3)
        (= (numerator 2.5) 2.5)
        (= (gcd 6 4) 2)
        (= (lcm 6 4) 12)
        (= (gcd 6.5 4.0) 2)
        (= (lcm 6.5 4.0) 12)
        (= (modulo normal 1.0) 0.5)
        (= (saved-modulo normal 1.0) 0.5)
        (= (remainder normal 1.0) -0.5)
        (= (saved-remainder normal 1.0) -0.5)
        (= (quotient normal 1.0) -1.0)
        (= (saved-quotient normal 1.0) -1.0)
        (integer-helper-rejects? (lambda () (f32_integer_gcd_probe normal)))
        (integer-helper-rejects? (lambda () (f32_integer_lcm_probe normal)))
        (integer-helper-rejects? (lambda () (f32_integer_gcd_stored_probe normal)))
        (integer-helper-rejects? (lambda () (f32_integer_lcm_stored_probe normal))))
      1 0)))
