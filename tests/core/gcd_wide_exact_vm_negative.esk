(define saved-gcd gcd)
(define saved-lcm lcm)
(define wide (expt 2 70))
(define huge (expt 2 1100))
(define (raises? thunk)
  (guard (condition (else #t)) (begin (thunk) #f)))
(define ok
  (and
    (raises? (lambda () (gcd wide 6.0)))
    (raises? (lambda () (saved-gcd 6.0 wide)))
    (raises? (lambda () (gcd huge 0.0)))
    (raises? (lambda () (saved-gcd 0.0 huge)))
    (raises? (lambda () (gcd wide 6.5)))
    (raises? (lambda () (saved-gcd 6.5 wide)))
    (raises? (lambda () (gcd wide #t)))
    (raises? (lambda () (saved-gcd #t wide)))
    (raises? (lambda () (lcm wide 6.0)))
    (raises? (lambda () (saved-lcm 6.0 wide)))
    (raises? (lambda () (lcm huge 0.0)))
    (raises? (lambda () (saved-lcm 0.0 huge)))
    (raises? (lambda () (lcm wide #t)))
    (raises? (lambda () (saved-lcm #t wide)))
    (= (gcd 6.0 4.0) 2)
    (= (saved-gcd 6.0 4.0) 2)
    (inexact? (saved-gcd 6.0 4.0))))
(if ok (begin (display "PASS: gcd wide exact VM negatives") (newline))
    (begin (display "FAIL: gcd wide exact VM negatives") (newline)))
