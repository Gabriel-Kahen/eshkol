;;; extern void* — accepted as a friendlier alias for `ptr`, both as a
;;; return type and as a parameter type. Before this fix, `void*` fell
;;; through mapStringToType's "Unknown type '%s'" branch and silently
;;; became int64 (with only a warning), corrupting the call ABI for any
;;; extern using the spelling most C headers actually use.
;;;
;;; Declares and calls real C library functions end-to-end through
;;; void*-typed externs (malloc/free/memset — all fixed-arity, so safe on
;;; every platform, see lib/core/memory_store.esk's header on why variadic
;;; externs are not) and checks they behave identically to the existing
;;; `ptr` spelling.

(require stdlib)

;; void* malloc(size_t size)              — void* as a RETURN type
(extern void* vs-malloc i64 :real malloc)
;; void free(void* ptr)                   — void* as a PARAMETER type
(extern void vs-free void* :real free)
;; void* memset(void* s, int c, size_t n) — void* as BOTH
(extern void* vs-memset void* i32 i64 :real memset)

(define passed 0)
(define failed 0)
(define (check name expected actual)
  (if (equal? expected actual)
      (begin (display "PASS: ") (display name) (newline)
             (set! passed (+ passed 1)))
      (begin (display "FAIL: ") (display name)
             (display " expected=") (write expected)
             (display " actual=") (write actual) (newline)
             (set! failed (+ failed 1)))))

(define block (vs-malloc 264))
(check "void*-returning extern yields a non-null pointer"
       #t (> (ptr->usize block) 0))

;; The C allocation has no Eshkol header.  Mutating a slot that contains it
;; must not inspect bytes before the allocation, even under ASan.
(define foreign-slot block)
(set! foreign-slot block)
(check "foreign pointer survives mutable storage" #t (eq? foreign-slot block))
(check "foreign pointer has identity equality" #t (equal? foreign-slot block))
(define foreign-box (vector foreign-slot))
(check "foreign pointer survives container storage"
       #t (eq? (vector-ref foreign-box 0) block))
(define foreign-pair (cons block block))
(check "foreign pointer survives pair car" #t (eq? (car foreign-pair) block))
(check "foreign pointer survives pair cdr" #t (eq? (cdr foreign-pair) block))
(define nested-foreign (list 0 block))
(check "compound selector keeps the complete foreign tag" #t
       (eq? (cadr nested-foreign) block))
(define selected-port (open-output-string))
(check "compound selector keeps a port's full tag" #t
       (eq? (cadr (list 0 selected-port)) selected-port))
(check "foreign pointer is not a bytevector" #f (bytevector? block))
(check "bytevector length never reads a foreign header" #t
       (guard (exception (#t #t)) (bytevector-length block) #f))
(check "bytevector ref never reads a foreign header" #t
       (guard (exception (#t #t)) (bytevector-u8-ref block 0) #f))
(check "bytevector copy never reads a foreign header" #t
       (guard (exception (#t #t)) (bytevector-copy block) #f))
(check "string conversion never reads a foreign header" #t
       (guard (exception (#t #t)) (string->utf8 block) #f))
(define captured-foreign
  (let ((captured foreign-slot)) (lambda () captured)))
(check "foreign pointer survives closure capture" #t (eq? (captured-foreign) block))
(let ((out (open-output-string)))
  (display block out)
  (check "foreign display never reads a managed header"
         "#<foreign-ptr>" (get-output-string out)))

;; Write through the void*-typed pointer and read it back via the same
;; volatile-op access path tests/ffi/low_level_memory_surface_test.esk uses
;; for `ptr` — proves void* reaches codegen as a real pointer, not an int64.
(volatile-store! i64 block 424242)
(check "value written through a void*-return pointer round-trips"
       424242 (volatile-load i64 block))

;; memset: void* used as both a parameter AND the return type of one call.
(define filled (vs-memset block 0 264))
(check "memset (void* param + void* return) yields the same pointer"
       (ptr->usize block) (ptr->usize filled))
(check "memset actually zeroed the block"
       0 (volatile-load i64 block))

;; The conversion boundary must reject a scalar or a resource before using
;; its payload as a native address. These guards exercise runtime values, not
;; a compile-time integer spelling masquerading as a pointer.
(define (ptr-usize-rejected value)
  (guard (exception (#t #t)) (ptr->usize value) #f))
(define (ptr-string-rejected value)
  (guard (exception (#t #t)) (ptr->string value) #f))
(define (ptr-string-n-rejected pointer length)
  (guard (exception (#t #t)) (ptr->string-n pointer length) #f))
(check "ptr->usize rejects scalar" #t (ptr-usize-rejected 17))
(check "ptr->usize rejects true" #t (ptr-usize-rejected #t))
(check "ptr->usize accepts false null" 0 (ptr->usize #f))
(check "usize->ptr rejects negative address" #t
       (guard (exception (#t #t)) (usize->ptr -1) #f))
(check "ptr->string rejects scalar" #t (ptr-string-rejected 17))
(check "ptr->string-n rejects scalar pointer" #t
       (ptr-string-n-rejected 17 0))
(check "ptr->string-n rejects pointer as length" #t
       (ptr-string-n-rejected block block))
(check "ptr->string-n retains empty null case" "" (ptr->string-n #f 0))

(vs-free block)

(display "extern void* surface: ") (display passed) (display " passed, ")
(display failed) (display " failed") (newline)
(if (> failed 0) (exit 1) (exit 0))
