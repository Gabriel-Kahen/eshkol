(define-syntax install-helper
  (syntax-rules () ((_)
    (define (helper x) (+ x 1)))))

; The ordinary seed definition is parser-lowered before macro expansion.
; A later definition inside begin must not bypass the mixed-body rejection.
(define (outer n)
  (define seed n)
  (begin (install-helper) 0)
  (helper seed))

(outer 4)
